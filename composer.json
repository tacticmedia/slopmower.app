{
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "doctrine/doctrine-bundle": "^3.3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7.6",
        "hwi/oauth-bundle": "^2.6",
        "lcobucci/jwt": "^5.6.0",
        "league/commonmark": "^2.10.7",
        "mcp/sdk": "0.8.1",
        "nikic/php-parser": "^5.9.0",
        "nyholm/psr7": "^1.8",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.4.1",
        "sentry/sentry": "^4.35.0",
        "sentry/sentry-symfony": "^5.15",
        "symfony/asset": "~8.1.0",
        "symfony/clock": "~8.1.0",
        "symfony/console": "~8.1.11",
        "symfony/doctrine-messenger": "~8.1.11",
        "symfony/dotenv": "~8.1.0",
        "symfony/expression-language": "~8.1.0",
        "symfony/filesystem": "~8.1.11",
        "symfony/finder": "~8.1.11",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "~8.1.11",
        "symfony/http-client": "~8.1.11",
        "symfony/lock": "~8.1.11",
        "symfony/mcp-bundle": "0.14.1",
        "symfony/mercure-bundle": "^0.5.0",
        "symfony/mime": "~8.1.10",
        "symfony/monolog-bundle": "^3.0 || ^4.0",
        "symfony/process": "~8.1.10",
        "symfony/property-access": "~8.1.11",
        "symfony/property-info": "~8.1.11",
        "symfony/rate-limiter": "~8.1.11",
        "symfony/remote-event": "~8.1.0",
        "symfony/reprise": "1.3.0",
        "symfony/runtime": "~8.1.11",
        "symfony/scheduler": "~8.1.10",
        "symfony/security-bundle": "~8.1.11",
        "symfony/serializer": "~8.1.11",
        "symfony/string": "~8.1.10",
        "symfony/translation": "~8.1.11",
        "symfony/twig-bundle": "~8.1.0",
        "symfony/uid": "~8.1.0",
        "symfony/validator": "~8.1.11",
        "symfony/var-exporter": "~8.1.10",
        "symfony/web-link": "~8.1.0",
        "symfony/webhook": "~8.1.0",
        "symfony/yaml": "~8.1.11",
        "tacticmedia/rds-auth-bundle": "^1.2",
        "twig/extra-bundle": "^2.12 || ^3.0",
        "twig/markdown-extra": "^3.29.0",
        "twig/twig": "^2.12 || ^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": ">=2.56",
        "friendsofphp/php-cs-fixer": "^3.95.28",
        "helgesverre/toon": "^3.2",
        "opis/json-schema": "^2.6",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.6",
        "playwright-php/playwright": "1.5.0",
        "symfony/ai-mate": "^0.14.0",
        "symfony/ai-monolog-mate-extension": "^0.14.0",
        "symfony/ai-symfony-mate-extension": "^0.14.0",
        "symfony/browser-kit": "~8.1.11",
        "symfony/css-selector": "~8.1.10",
        "symfony/debug-bundle": "~8.1.0",
        "symfony/maker-bundle": "^1.0",
        "symfony/stopwatch": "~8.1.0",
        "symfony/web-profiler-bundle": "~8.1.11",
        "tacticmedia/qa-bundle": "^2.0",
        "zenstruck/foundry": "^2.15"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Mate\\": "mate/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/ai-mate-composer-plugin": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "ai-mate": {
            "extension": false,
            "includes": [
                "mate/config.php"
            ],
            "instructions": "mate/INSTRUCTIONS.md",
            "scan-dirs": [
                "mate/src"
            ]
        },
        "ergebnis-json-normalizer": {
            "path": [
                "composer.json",
                "composer.lock"
            ]
        },
        "symfony": {
            "allow-contrib": true,
            "docker": false,
            "require": "8.1.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts",
            "@dev-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts",
            "@dev-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "dev-scripts": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || composer normalize)"
        ]
    }
}
