# Adapted from https://github.com/dunglas/symfony-docker. Local development only.
{
	skip_install_trust
}

(redact_mercure_authorization) {
	log {
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}
}

(compress_except_hub) {
	# A compressed event stream costs memory per subscriber and is open to BREACH-style attacks.
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip
}

# dev environment, worker mode
{$SERVER_NAME} {
	import redact_mercure_authorization

	root /app/public
	import compress_except_hub

	mercure {
		# Handlers with one name are one hub: the pentest stack serves this site over HTTP and HTTPS.
		name dev
		protocol_version_compatibility 8
		publisher_jwt {env.MERCURE_JWT_SECRET}
		subscriber_jwt {env.MERCURE_JWT_SECRET}
		cors_origins http://localhost:{$HTTP_PORT:8000}
	}

	php_server {
		worker {
			file /app/public/index.php
			# Only application directories: a pattern at /app would also watch the worktrees under /app/.claude.
			watch /app/src/**/*.php
			watch /app/config/**/*.{php,yaml}
			watch /app/templates/**/*.twig
			# Reprise keeps the parsed entrypoints in memory. Keep the file out of public/build: the bind mount drops the
			# create event of a directory that gets files at once, so the watcher never watches a new public/build.
			watch /app/public/entrypoints.json
		}
	}
}

# e2e environment, classic mode, for the full-stack tests inside this container
:8081 {
	import redact_mercure_authorization

	root /app/public
	import compress_except_hub

	mercure {
		name e2e
		protocol_version_compatibility 8
		publisher_jwt {env.MERCURE_JWT_SECRET}
		subscriber_jwt {env.MERCURE_JWT_SECRET}
		# The default bolt transport is one file: a second hub on it does not start.
		transport local
	}

	php_server {
		env APP_ENV e2e
	}
}
