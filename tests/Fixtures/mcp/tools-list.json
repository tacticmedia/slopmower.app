{
    "tools": [
        {
            "name": "list_repositories",
            "title": "List repositories",
            "description": "List the repositories that this token can see: id, source (github or local), name, default branch, and number of open reviews. Use the name or id as `repository` in list_reviews.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "cursor": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "nextCursor of the previous page",
                        "default": null,
                        "minLength": 1
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Page size",
                        "default": 100,
                        "minimum": 1,
                        "maximum": 500
                    }
                }
            },
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "list_reviews",
            "title": "List reviews",
            "description": "List the reviews of one repository, newest first. Only open reviews unless includeClosed is true. Each review is pinned to one commit and holds its own requests; pass its id as `review` to get_updates and list_requests.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "repository": {
                        "type": "string",
                        "description": "Repository ID, GitHub owner/name, or local directory name",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "includeClosed": {
                        "type": "boolean",
                        "description": "Also list closed reviews",
                        "default": false
                    },
                    "cursor": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "nextCursor of the previous page",
                        "default": null,
                        "minLength": 1
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Page size",
                        "default": 50,
                        "minimum": 1,
                        "maximum": 100
                    }
                },
                "required": [
                    "repository"
                ]
            },
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "list_requests",
            "title": "List requests",
            "description": "List the change requests of one review, oldest first, with optional filters. Returns summaries: title is null while a request has none, and summary is the title or else the first line of the body. Call get_request for the body, thread, anchor, and location.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "review": {
                        "type": "string",
                        "description": "Review ID from list_reviews",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "status": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Only requests with this status",
                        "default": null,
                        "enum": [
                            "open",
                            "in_progress",
                            "ready_for_review",
                            "verified",
                            "reopened",
                            "wont_do",
                            null
                        ]
                    },
                    "awaiting": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Only requests where it is this party's turn; \"agent\" means you",
                        "default": null,
                        "enum": [
                            "agent",
                            "user",
                            "none",
                            null
                        ]
                    },
                    "path": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Only requests whose file path starts with this prefix; general requests never match",
                        "default": null,
                        "minLength": 1,
                        "maxLength": 4096
                    },
                    "outdated": {
                        "type": [
                            "null",
                            "boolean"
                        ],
                        "description": "Only requests whose code changed (true) or did not change (false) on the default branch",
                        "default": null
                    },
                    "suggestion": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Only suggestions in this state; requests that the user opened never match",
                        "default": null,
                        "enum": [
                            "pending",
                            "accepted",
                            "dismissed",
                            null
                        ]
                    },
                    "cursor": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "nextCursor of the previous page",
                        "default": null,
                        "minLength": 1
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Page size",
                        "default": 50,
                        "minimum": 1,
                        "maximum": 200
                    }
                },
                "required": [
                    "review"
                ]
            },
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "get_updates",
            "title": "Get updates",
            "description": "Return what changed in one review since `cursor`, grouped by request, leaving out your own actions. Without a cursor, return every request that waits for you with its unseen events. Always keep the returned cursor for the next call; if hasMore is true, call again at once. reviewState 'closed' means stop.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "review": {
                        "type": "string",
                        "description": "Review ID from list_reviews",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "cursor": {
                        "type": [
                            "null",
                            "integer"
                        ],
                        "description": "The cursor from the previous call. Null returns everything that waits for you.",
                        "default": null,
                        "minimum": 0
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum events (with a cursor) or requests (without one)",
                        "default": 100,
                        "minimum": 1,
                        "maximum": 500
                    }
                },
                "required": [
                    "review"
                ]
            },
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "get_request",
            "title": "Get request",
            "description": "Return one request in full: title, body, thread, anchor with a code snapshot at the review commit, linked commits, location, and the actions you may take now (allowedActions). `at` locates the anchor at another commit that the server's clone has (pushed, or committed in a local repository); by default the location is at the default-branch head. Your working tree can differ: find the code with anchor.snapshot, its before and after lines, and anchor.symbol.fqn. A general request has anchor, location, and excerpt null. It belongs to the whole review, and its body and thread say what to change. A request with title null has no title: give it one with set_request_title before you claim it.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "at": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Commit SHA (7-64 hex digits) to locate the anchor at",
                        "default": null,
                        "pattern": "^[0-9a-f]{7,64}$"
                    },
                    "context": {
                        "type": [
                            "null",
                            "integer"
                        ],
                        "description": "Lines of context around the located code to include as excerpt",
                        "default": null,
                        "minimum": 0,
                        "maximum": 50
                    }
                },
                "required": [
                    "id"
                ]
            },
            "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "claim_request",
            "title": "Claim request",
            "description": "Claim an open or reopened request before you edit code for it. Status becomes in_progress. Claiming a request that you already hold succeeds and changes nothing. Fails with invalid_transition when the status does not allow it or another agent holds it: then take the next request.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    }
                },
                "required": [
                    "id"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "release_request",
            "title": "Release request",
            "description": "Give back a request that you claimed but will not finish. Its status returns to what it was before the claim (open or reopened).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "note": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Why you stop, for the user",
                        "default": null,
                        "maxLength": 65536
                    }
                },
                "required": [
                    "id"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "reply_to_request",
            "title": "Reply to request",
            "description": "Add a comment to a request's thread, in any status. Set question to true when you need the user's answer; the request then waits for the user and comes back through get_updates when they reply.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "body": {
                        "type": "string",
                        "description": "Markdown comment",
                        "minLength": 1,
                        "maxLength": 65536
                    },
                    "question": {
                        "type": "boolean",
                        "description": "True when you need an answer from the user",
                        "default": false
                    }
                },
                "required": [
                    "id",
                    "body"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "link_commits",
            "title": "Link commits",
            "description": "Record that a commit implements one or more requests that you hold (status in_progress). Use the full SHA from `git rev-parse HEAD`. The commit may be unpushed: the link stays pending until the server's clone has it. Linking does not finish a request.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "commitSha": {
                        "type": "string",
                        "description": "Full commit SHA",
                        "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    "requestIds": {
                        "type": "array",
                        "description": "Every request that this commit covers, all from one review",
                        "items": {
                            "type": "string",
                            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                        },
                        "minItems": 1,
                        "maxItems": 50,
                        "uniqueItems": true
                    },
                    "note": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Optional note shown with the link",
                        "default": null,
                        "maxLength": 65536
                    }
                },
                "required": [
                    "commitSha",
                    "requestIds"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "unlink_commit",
            "title": "Unlink commit",
            "description": "Remove a commit link that you made by mistake from a request that you hold.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "commitSha": {
                        "type": "string",
                        "description": "Full commit SHA",
                        "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    "requestId": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    }
                },
                "required": [
                    "commitSha",
                    "requestId"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "mark_ready_for_review",
            "title": "Mark ready for review",
            "description": "Tell the user that a request you hold is done. The note says what you changed and how you tested it. Every linked commit must be in the server's clone: for GitHub repositories push first (the server fetches once), otherwise this fails with commits_not_available. A request that needs no code change may have no commits; say why in the note.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "note": {
                        "type": "string",
                        "description": "What you changed and how you tested it",
                        "minLength": 1,
                        "maxLength": 65536
                    }
                },
                "required": [
                    "id",
                    "note"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "mark_wont_do",
            "title": "Mark won't do",
            "description": "Decline an open or reopened request, or one that you hold. Give evidence that the user can check: a file and line, a test result, a conflicting requirement, or why the request is wrong. At least 20 characters. The user then verifies or reopens it.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "reason": {
                        "type": "string",
                        "description": "Checkable justification, at least 20 characters",
                        "minLength": 20,
                        "maxLength": 65536
                    }
                },
                "required": [
                    "id",
                    "reason"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "propose_solution",
            "title": "Propose solution",
            "description": "Propose how you will solve a request that you hold, before you link commits. Required when the request has requireApproval true; also useful when the request is unclear or large. A new proposal replaces the current one. The user approves it or requests changes: the decision comes back through get_updates, and get_request shows it in proposal.state. Until the user approves, link_commits and mark_ready_for_review fail with invalid_transition.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "plan": {
                        "type": "string",
                        "description": "Markdown plan: what you will change, and why",
                        "minLength": 1,
                        "maxLength": 65536
                    },
                    "diff": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Optional unified diff of the change from `git diff`, at most 9 files",
                        "default": null,
                        "minLength": 1,
                        "maxLength": 65536
                    }
                },
                "required": [
                    "id",
                    "plan"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "link_pull_request",
            "title": "Link pull request",
            "description": "Record that a pull request implements one or more requests: each one in_progress and held by you, or ready_for_review. For a GitHub repository the URL is https://github.com/{owner}/{name}/pull/{number} of the reviewed repository. Linking does not change the status. Open a pull request only when the user or the repository's instructions ask for it.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "Pull request URL",
                        "maxLength": 2048,
                        "pattern": "^https://\\S+$"
                    },
                    "requestIds": {
                        "type": "array",
                        "description": "Every request that this pull request covers, all from one review",
                        "items": {
                            "type": "string",
                            "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                        },
                        "minItems": 1,
                        "maxItems": 50,
                        "uniqueItems": true
                    },
                    "note": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Optional note shown with the link",
                        "default": null,
                        "maxLength": 65536
                    }
                },
                "required": [
                    "url",
                    "requestIds"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "unlink_pull_request",
            "title": "Unlink pull request",
            "description": "Remove a pull request link that you made by mistake from a request: in_progress and held by you, or ready_for_review.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "description": "Pull request URL",
                        "maxLength": 2048,
                        "pattern": "^https://\\S+$"
                    },
                    "requestId": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    }
                },
                "required": [
                    "url",
                    "requestId"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "start_review",
            "title": "Start review",
            "description": "Start a review of one repository, pinned to one commit, when the user asks you to review code and no review was named. Without ref, the review pins the head of the default branch. Read the code at the returned commitSha, then call suggest_request once per finding.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "repository": {
                        "type": "string",
                        "description": "Repository ID, GitHub owner/name, or local directory name",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "ref": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Branch, tag, or commit SHA to pin; null for the default branch",
                        "default": null,
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "title": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Review title; null for \"<ref> @ <short SHA>\"",
                        "default": null,
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": [
                    "repository"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "suggest_request",
            "title": "Suggest request",
            "description": "Suggest one change while you review code. The suggestion is a request that waits for the user, who accepts or dismisses it; do not edit code for it. Give it a title: one line of at most 80 characters that summarizes the body. Use the narrowest anchor: anchorKind line or range with path, startLine, and endLine; symbol with path and the fully qualified name in symbol, for example App\\Billing\\InvoiceTotals::total(); file with path. Without anchorKind the suggestion concerns the whole review. If the server does not find the symbol, use a range. An accepted suggestion comes back through get_updates as a request that waits for you.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "review": {
                        "type": "string",
                        "description": "Review ID from start_review or list_reviews",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "title": {
                        "type": "string",
                        "description": "One line of at most 80 characters that summarizes the body",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "body": {
                        "type": "string",
                        "description": "Markdown: what to change, and why",
                        "minLength": 1,
                        "maxLength": 65536
                    },
                    "anchorKind": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "line, range, symbol, or file; null for a general request",
                        "default": null,
                        "enum": [
                            "line",
                            "range",
                            "symbol",
                            "file",
                            null
                        ]
                    },
                    "path": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "File path at the review commit; required with anchorKind",
                        "default": null,
                        "minLength": 1,
                        "maxLength": 4096
                    },
                    "startLine": {
                        "type": [
                            "null",
                            "integer"
                        ],
                        "description": "First line, for line and range",
                        "default": null,
                        "minimum": 1
                    },
                    "endLine": {
                        "type": [
                            "null",
                            "integer"
                        ],
                        "description": "Last line, for line and range; equal to startLine for line",
                        "default": null,
                        "minimum": 1
                    },
                    "symbol": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "description": "Fully qualified name of the symbol, for symbol",
                        "default": null,
                        "minLength": 1,
                        "maxLength": 1024
                    }
                },
                "required": [
                    "review",
                    "title",
                    "body"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "set_request_title",
            "title": "Set request title",
            "description": "Set the title of a request whose title is null: one line of at most 80 characters that summarizes its body. Call it before you claim such a request. Fails with invalid_transition when the request has a title; only the user changes a title.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Request ID",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
                    },
                    "title": {
                        "type": "string",
                        "description": "One line of at most 80 characters that summarizes the body",
                        "minLength": 1,
                        "maxLength": 200
                    }
                },
                "required": [
                    "id",
                    "title"
                ]
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        }
    ]
}
