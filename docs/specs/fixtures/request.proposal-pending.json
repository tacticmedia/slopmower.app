      "occurredAt": "2026-09-29T08:05:00Z",
      "body": "Add `InvoiceTotalsCsv::export()`, which writes the total and the tax as one CSV row, and `InvoiceTotals::toCsv()`, which calls it.",
      "diff": "diff --git a/src/Billing/InvoiceTotals.php b/src/Billing/InvoiceTotals.php\nindex 3b18e51..7c4d2a9 100644\n--- a/src/Billing/InvoiceTotals.php\n+++ b/src/Billing/InvoiceTotals.php\n@@ -48,5 +48,10 @@\n         return $sum;\n     }\n \n+    public function toCsv(): string\n+    {\n+        return new InvoiceTotalsCsv()->export($this);\n+    }\n+\n     public function tax(): float\n     {\ndiff --git a/src/Billing/InvoiceTotalsCsv.php b/src/Billing/InvoiceTotalsCsv.php\nnew file mode 100644\nindex 0000000..4f2a1c3\n--- /dev/null\n+++ b/src/Billing/InvoiceTotalsCsv.php\n@@ -0,0 +1,13 @@\n+<?php\n+\n+declare(strict_types=1);\n+\n+namespace App\\Billing;\n+\n+final class InvoiceTotalsCsv\n+{\n+    public function export(InvoiceTotals $totals): string\n+    {\n+        return \"total,tax\\n\".$totals->total().','.$totals->tax().\"\\n\";\n+    }\n+}\n",
