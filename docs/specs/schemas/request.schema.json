{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/request.schema.json",
  "title": "Request",
  "description": "A request in full. Same fields as RequestSummary, with the full anchor and more.",
  "type": "object",
  "required": ["id", "reviewId", "repositoryId", "status", "awaiting", "resolution", "closed", "anchor", "title", "summary", "author", "claimedBy", "claimedAt", "commentCount", "commitCount", "pendingCommitCount", "outdated", "createdAt", "updatedAt", "lastEventSeq", "carriedFrom", "requireApproval", "suggestion", "proposal", "body", "reviewState", "reviewCommitSha", "location", "excerpt", "thread", "commits", "pullRequestUrls", "pullRequests", "allowedActions"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "reviewId": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "repositoryId": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/RequestStatus"
    },
    "awaiting": {
      "$ref": "common.schema.json#/$defs/Awaiting"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Resolution"
        },
        {
          "type": "null"
        }
      ]
    },
    "closed": {
      "type": "boolean"
    },
    "anchor": {
      "anyOf": [
        {
          "$ref": "anchor.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null for a general request, which belongs to the whole review."
    },
    "title": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Title"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null while the request has no title."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The title when set, else the first non-blank line of body, trimmed. A longer line is cut and ends with U+2026 HORIZONTAL ELLIPSIS."
    },
    "author": {
      "$ref": "actor.schema.json"
    },
    "claimedBy": {
      "anyOf": [
        {
          "$ref": "actor.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "claimedAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "commentCount": {
      "type": "integer",
      "minimum": 0
    },
    "commitCount": {
      "type": "integer",
      "minimum": 0
    },
    "pendingCommitCount": {
      "type": "integer",
      "minimum": 0
    },
    "outdated": {
      "type": ["boolean", "null"]
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "lastEventSeq": {
      "$ref": "common.schema.json#/$defs/EventSeq"
    },
    "carriedFrom": {
      "anyOf": [
        {
          "$ref": "request-summary.schema.json#/$defs/CarriedFrom"
        },
        {
          "type": "null"
        }
      ]
    },
    "requireApproval": {
      "type": "boolean"
    },
    "suggestion": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/SuggestionState"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Proposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "$ref": "common.schema.json#/$defs/Markdown"
    },
    "reviewState": {
      "$ref": "common.schema.json#/$defs/ReviewState"
    },
    "reviewCommitSha": {
      "$ref": "common.schema.json#/$defs/CommitSha"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "location.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "At `at` when given, else at the default-branch head."
    },
    "excerpt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeExcerpt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Only when `context` was given."
    },
    "thread": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "thread-entry.schema.json"
      },
      "description": "Ascending seq; starts with request.opened."
    },
    "commits": {
      "type": "array",
      "items": {
        "$ref": "commit-link.schema.json"
      }
    },
    "pullRequestUrls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/PullRequestUrl"
      },
      "description": "In link order."
    },
    "pullRequests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PullRequest"
      },
      "description": "One entry per URL of pullRequestUrls, in the same order."
    },
    "allowedActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/Action"
      },
      "description": "For the caller. Empty when the review is closed."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "in_progress"
          }
        }
      },
      "then": {
        "properties": {
          "claimedBy": {
            "$ref": "actor.schema.json"
          },
          "claimedAt": {
            "$ref": "common.schema.json#/$defs/DateTime"
          }
        }
      },
      "else": {
        "properties": {
          "claimedBy": {
            "type": "null"
          },
          "claimedAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": ["anchor"],
        "properties": {
          "anchor": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "location": {
            "type": "null"
          },
          "excerpt": {
            "type": "null"
          },
          "outdated": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "PullRequest": {
      "type": "object",
      "required": ["url", "state", "title"],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/PullRequestUrl"
        },
        "state": {
          "$ref": "common.schema.json#/$defs/PullRequestState"
        },
        "title": {
          "type": ["string", "null"],
          "description": "The title on GitHub. Null when state is unknown."
        }
      },
      "if": {
        "required": ["state"],
        "properties": {
          "state": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "title": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "title": {
            "type": "string"
          }
        }
      }
    },
    "CodeExcerpt": {
      "type": "object",
      "required": ["targetSha", "path", "startLine", "endLine", "lines", "truncated"],
      "properties": {
        "targetSha": {
          "$ref": "common.schema.json#/$defs/CommitSha"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/RepoPath"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "string"
          },
          "description": "Raw lines startLine to endLine, without line endings."
        },
        "truncated": {
          "type": "boolean",
          "description": "True when cut at 400 lines."
        }
      }
    }
  }
}
