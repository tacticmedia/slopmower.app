{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holistic-review.invalid/schemas/v1/api-token.schema.json",
  "title": "ApiToken",
  "type": "object",
  "required": ["id", "name", "scope", "repositoryId", "repositoryName", "prefix", "state", "createdAt", "expiresAt", "lastUsedAt", "revokedAt"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "name": {
      "$ref": "#/$defs/TokenName"
    },
    "scope": {
      "enum": ["all_repositories", "repository"]
    },
    "repositoryId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        {
          "type": "null"
        }
      ]
    },
    "repositoryName": {
      "type": ["string", "null"]
    },
    "prefix": {
      "type": "string",
      "pattern": "^hr_[A-Za-z0-9_-]{6}$",
      "description": "First 9 characters of the secret."
    },
    "state": {
      "enum": ["active", "expired", "revoked"]
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "expiresAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastUsedAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        {
          "type": "null"
        }
      ],
      "description": "Updated at most once per minute."
    },
    "revokedAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "repository"
          }
        }
      },
      "then": {
        "properties": {
          "repositoryId": {
            "$ref": "common.schema.json#/$defs/Ulid"
          },
          "repositoryName": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "repositoryId": {
            "type": "null"
          },
          "repositoryName": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "TokenName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._@():-]*$",
      "description": "The agent name on every event made with this token."
    },
    "ApiTokenWithSecret": {
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "type": "object",
          "required": ["secret"],
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^hr_[A-Za-z0-9_-]{43}$",
              "description": "hr_ + base64url(32 random bytes), no padding. Shown once."
            }
          }
        }
      ]
    }
  }
}
