{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/inputs.schema.json",
  "title": "REST request bodies",
  "$defs": {
    "ConnectRepositoryInput": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/RepositorySource"
        },
        "githubRepositoryId": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "directory": {
          "anyOf": [
            {
              "$ref": "repository.schema.json#/$defs/LocalDirectory"
            },
            {
              "type": "null"
            }
          ]
        },
        "codeAccess": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/CodeAccess"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for github, without a default. Absent, null, or clone for local."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "github"
              }
            }
          },
          "then": {
            "required": ["githubRepositoryId", "codeAccess"],
            "properties": {
              "githubRepositoryId": {
                "type": "integer"
              },
              "codeAccess": {
                "$ref": "common.schema.json#/$defs/CodeAccess"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": ["directory"],
            "properties": {
              "directory": {
                "type": "string"
              },
              "codeAccess": {
                "enum": ["clone", null]
              }
            }
          }
        }
      ]
    },
    "StartReviewInput": {
      "type": "object",
      "properties": {
        "ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 255,
          "description": "Default: the default branch."
        },
        "title": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "CloseReviewInput": {
      "type": "object",
      "properties": {
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "CarryOverInput": {
      "type": "object",
      "required": ["fromReviewId"],
      "properties": {
        "fromReviewId": {
          "$ref": "common.schema.json#/$defs/Ulid",
          "description": "The source review: another review of the same repository."
        }
      }
    },
    "OpenRequestInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "anchor.schema.json#/$defs/AnchorInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null opens a general request."
        },
        "title": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Title"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null opens the request without a title. Q23 sets it later."
        },
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "requireApproval": {
          "type": ["boolean", "null"],
          "default": false,
          "description": "\"Ask for a plan first\". Q18 changes it later."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/RequestType"
            },
            {
              "type": "null"
            }
          ],
          "default": "change",
          "description": "Absent or null: change. It does not change after the request opens. An unknown value answers 422."
        },
        "group": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Group"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null: no group. It does not change after the request opens."
        }
      }
    },
    "SuggestRequestInput": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "anchor.schema.json#/$defs/AnchorInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null suggests a general request."
        },
        "title": {
          "$ref": "common.schema.json#/$defs/Title"
        },
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        }
      }
    },
    "CommentInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": {
          "type": "string",
          "maxLength": 65536,
          "description": "GitHub-flavoured Markdown with at least one non-whitespace character. May be empty when questions is not empty."
        },
        "question": {
          "type": "boolean",
          "default": false,
          "description": "Agents only. A comment of an agent with questions is a question."
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionInput"
          },
          "maxItems": 10,
          "default": [],
          "description": "D107. An agent asks without answers. A user answers every question of an agent comment and repeats each question."
        }
      }
    },
    "QuestionInput": {
      "type": "object",
      "required": ["question"],
      "properties": {
        "question": {
          "$ref": "common.schema.json#/$defs/QuestionText"
        },
        "detail": {
          "type": ["string", "null"],
          "maxLength": 4000,
          "default": null,
          "description": "Markdown that gives the context of the question."
        },
        "answer": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S",
          "default": null,
          "description": "Users only, required from them: Yes, No, or text. The server trims it, then checks the length."
        }
      }
    },
    "OptionalNoteInput": {
      "type": "object",
      "properties": {
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "RequiredNoteInput": {
      "type": "object",
      "required": ["note"],
      "properties": {
        "note": {
          "$ref": "common.schema.json#/$defs/Markdown"
        }
      }
    },
    "WontDoInput": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 65536,
          "description": "20 or more characters after trimming."
        }
      }
    },
    "ProposeSolutionInput": {
      "type": "object",
      "required": ["plan"],
      "properties": {
        "plan": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/UnifiedDiff"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApproveProposalInput": {
      "type": "object",
      "required": ["proposalEventId"],
      "properties": {
        "proposalEventId": {
          "$ref": "common.schema.json#/$defs/Ulid",
          "description": "Request.proposal.eventId, so a newer proposal is never approved by mistake."
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "CheckEveryPullRequestInput": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "The new value of `github.checkEveryPullRequest`."
        }
      }
    },
    "CodeAccessInput": {
      "type": "object",
      "required": ["codeAccess"],
      "properties": {
        "codeAccess": {
          "$ref": "common.schema.json#/$defs/CodeAccess"
        }
      }
    },
    "PlanRequirementInput": {
      "type": "object",
      "required": ["requireApproval"],
      "properties": {
        "requireApproval": {
          "type": "boolean",
          "description": "The new value of \"Ask for a plan first\"."
        }
      }
    },
    "AcceptSuggestionInput": {
      "type": "object",
      "properties": {
        "requireApproval": {
          "type": ["boolean", "null"],
          "description": "\"Ask for a plan first\". Absent or null keeps the value."
        }
      }
    },
    "DismissSuggestionInput": {
      "type": "object",
      "properties": {
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "TitleInput": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/Title",
          "description": "The new title. A title cannot be removed."
        }
      }
    },
    "LinkCommitsInput": {
      "type": "object",
      "required": ["commitSha", "requestIds"],
      "properties": {
        "commitSha": {
          "$ref": "common.schema.json#/$defs/CommitSha"
        },
        "requestIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Ulid"
          }
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "LinkPullRequestInput": {
      "type": "object",
      "required": ["url", "requestIds"],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/PullRequestUrl"
        },
        "requestIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Ulid"
          }
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "UnlinkPullRequestInput": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/PullRequestUrl"
        }
      }
    },
    "CreateDraftInput": {
      "type": "object",
      "required": ["kind", "body"],
      "properties": {
        "kind": {
          "enum": ["new_request", "reply"]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "anchor.schema.json#/$defs/AnchorInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "new_request: absent or null makes a general request. reply: absent or null."
        },
        "requestId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Title"
            },
            {
              "type": "null"
            }
          ],
          "description": "new_request only. Absent or null: no title."
        },
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "requireApproval": {
          "type": ["boolean", "null"],
          "default": false,
          "description": "new_request only. Absent or null: false."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/RequestType"
            },
            {
              "type": "null"
            }
          ],
          "default": "change",
          "description": "new_request only. Absent or null: change. An unknown value answers 422."
        },
        "group": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Group"
            },
            {
              "type": "null"
            }
          ],
          "description": "new_request only. Absent or null: no group."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "new_request"
              }
            }
          },
          "then": {
            "properties": {
              "requestId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reply"
              }
            }
          },
          "then": {
            "required": ["requestId"],
            "properties": {
              "requestId": {
                "type": "string"
              },
              "anchor": {
                "type": "null"
              },
              "title": {
                "type": "null"
              },
              "requireApproval": {
                "type": "null"
              },
              "type": {
                "type": "null"
              },
              "group": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "UpdateDraftInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "title": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Title"
            },
            {
              "type": "null"
            }
          ],
          "description": "Replaces the title together with body: absent or null removes it. A title on a reply draft answers 422."
        },
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "requireApproval": {
          "type": ["boolean", "null"],
          "description": "new_request drafts only; a reply draft answers 422. Absent or null keeps the value."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/RequestType"
            },
            {
              "type": "null"
            }
          ],
          "description": "new_request drafts only; a reply draft answers 422. Absent or null keeps the value. An unknown value answers 422."
        },
        "group": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Group"
            },
            {
              "type": "null"
            }
          ],
          "description": "Replaces the group: absent or null removes it. A group on a reply draft answers 422."
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "anchor.schema.json#/$defs/AnchorInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Moves a new_request draft, captured as in D2. Absent or null keeps the anchor. An anchor on a reply draft answers 422."
        }
      }
    },
    "SubmitDraftsInput": {
      "type": "object",
      "properties": {
        "summary": {
          "type": ["string", "null"],
          "maxLength": 65536
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryInput",
          "description": "Absent or null: the review keeps its delivery choices. pullRequest true needs Review.capabilities.pullRequests."
        },
        "draftIds": {
          "type": ["array", "null"],
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Ulid"
          },
          "description": "Absent or null: every draft of the caller in the review. Else only these drafts, and the other drafts stay. An ID that is not a draft of the caller in the review answers 422."
        }
      }
    },
    "DeliveryInput": {
      "type": "object",
      "properties": {
        "workspace": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Workspace"
            },
            {
              "type": "null"
            }
          ],
          "description": "An unknown value answers 422."
        },
        "pullRequest": {
          "type": ["boolean", "null"]
        }
      },
      "description": "Delivery as input. A missing key is null."
    },
    "ViewedFileInput": {
      "type": "object",
      "required": ["path", "viewed"],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/RepoPath"
        },
        "viewed": {
          "type": "boolean"
        }
      }
    },
    "CreateTokenInput": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "api-token.schema.json#/$defs/TokenName"
        },
        "repositoryId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null: all repositories of the tenant."
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null: no expiry. Else from now + 1 minute to now + 366 days."
        }
      }
    },
    "PreferencesInput": {
      "type": "object",
      "properties": {
        "completedTours": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Tour"
          },
          "description": "Replaces the completed tours. Absent or null keeps them. An unknown name or a name twice answers 422."
        }
      }
    },
    "IssueCommentInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": {
          "type": "string",
          "maxLength": 65536,
          "description": "The comment on the issue: GitHub-flavoured Markdown with at least one non-whitespace character. May be empty when questions is not empty, and with dismiss."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/CommentLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": "comment",
          "description": "Absent or null: comment. With questions or dismiss, the server sets question, answer, or dismissal, whatever the value is. Without them, the values question, answer, and dismissal are refused with 422. An unknown value answers 422."
        },
        "replaces": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ID of a comment of this issue that the new comment replaces. Absent or null: the comment replaces none. Required with answers and with dismiss: the open question comment that they answer or dismiss."
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionInput"
          },
          "maxItems": 10,
          "default": [],
          "description": "D124. An agent asks without answers. A user answers every question of the open question comment of replaces, and repeats each question in its order."
        },
        "dismiss": {
          "type": "boolean",
          "default": false,
          "description": "D124. true: a user does not answer the open question comment of replaces. The comment gets the label dismissal and the questions of that comment without answers, and an empty or whitespace body becomes \"Dismissed.\". Refused from a token and with questions."
        },
        "waitingFor": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/WaitingFor"
            },
            {
              "type": "null"
            }
          ],
          "description": "D136. A user hands the issue over with the comment, in one write: after the comment, the issue waits for this role in the status that it has. Absent or null: no hand-over. Refused from a token, and in backlog, done, and wont_do."
        },
        "planRevision": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "D136. Issue.planRevision of the plan that a review comment of a user asks to change. The entry stores it. Absent or null: the comment names no plan. Refused from a token, with another label than review, and for a revision that is not the newest."
        },
        "session": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/SessionName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The agent session that writes (D130). A token needs it. The server ignores it for a user."
        }
      }
    },
    "ApprovePlanInput": {
      "type": "object",
      "required": ["planRevision"],
      "properties": {
        "planRevision": {
          "$ref": "common.schema.json#/$defs/Ulid",
          "description": "Issue.planRevision of the plan that the user read, so a newer plan is never approved by mistake."
        }
      }
    },
    "CreateProjectInput": {
      "type": "object",
      "required": ["key", "name", "approvalMode"],
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/ProjectKey",
          "description": "A key that the tenant has already answers 422."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "At least one non-whitespace character. The server stores it trimmed."
        },
        "approvalMode": {
          "$ref": "common.schema.json#/$defs/ApprovalMode"
        },
        "approvalGuidelines": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ],
          "description": "Markdown. Absent, null, or whitespace only: no guidelines."
        }
      }
    },
    "UpdateProjectInput": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null keeps the name. At least one non-whitespace character. The server stores it trimmed."
        },
        "approvalMode": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ApprovalMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null keeps the mode."
        },
        "approvalGuidelines": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ],
          "description": "Markdown. Absent or null keeps the guidelines, and whitespace only removes them."
        },
        "repositoryIds": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 500,
              "items": {
                "$ref": "common.schema.json#/$defs/Ulid"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The whole list of the repositories of the project. Absent or null keeps the list, and an empty list removes every repository. An ID twice counts once."
        }
      }
    },
    "CreateIssueInput": {
      "type": "object",
      "required": ["title", "category"],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/Title"
        },
        "category": {
          "$ref": "common.schema.json#/$defs/IssueCategory",
          "description": "No default (D133)."
        },
        "problem": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ],
          "description": "Markdown. Absent or null: no problem. backlog and todo need one."
        },
        "acceptanceCriteria": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ],
          "description": "Markdown. Absent or null: no acceptance criteria."
        },
        "status": {
          "anyOf": [
            {
              "enum": ["draft", "backlog", "todo"]
            },
            {
              "type": "null"
            }
          ],
          "default": "draft",
          "description": "Absent or null: draft."
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/IssueApproval"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only in a project with the approval mode by_issue. Absent or null: user."
        },
        "requester": {
          "anyOf": [
            {
