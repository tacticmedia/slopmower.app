{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holistic-review.invalid/schemas/v1/inputs.schema.json",
  "title": "REST request bodies",
  "$defs": {
    "ConnectRepositoryInput": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/RepositorySource"
        },
        "githubRepositoryId": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "directory": {
          "anyOf": [
            {
              "$ref": "repository.schema.json#/$defs/LocalDirectory"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "github"
              }
            }
          },
          "then": {
            "required": ["githubRepositoryId"],
            "properties": {
              "githubRepositoryId": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "local"
              }
            }
          },
          "then": {
            "required": ["directory"],
            "properties": {
              "directory": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "StartReviewInput": {
      "type": "object",
      "properties": {
        "ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 255,
          "description": "Default: the default branch."
        },
        "title": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "CloseReviewInput": {
      "type": "object",
      "properties": {
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "CarryOverInput": {
      "type": "object",
      "required": ["fromReviewId"],
      "properties": {
        "fromReviewId": {
          "$ref": "common.schema.json#/$defs/Ulid",
          "description": "The source review: another review of the same repository."
        }
      }
    },
    "OpenRequestInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "anchor.schema.json#/$defs/AnchorInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent or null opens a general request."
        },
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "requireApproval": {
          "type": ["boolean", "null"],
          "default": false,
          "description": "\"Ask for a plan first\". Fixed when the request opens."
        }
      }
    },
    "CommentInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "question": {
          "type": "boolean",
          "default": false,
          "description": "Agents only."
        }
      }
    },
    "OptionalNoteInput": {
      "type": "object",
      "properties": {
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "RequiredNoteInput": {
      "type": "object",
      "required": ["note"],
      "properties": {
        "note": {
          "$ref": "common.schema.json#/$defs/Markdown"
        }
      }
    },
    "WontDoInput": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 65536,
          "description": "20 or more characters after trimming."
        }
      }
    },
    "ProposeSolutionInput": {
      "type": "object",
      "required": ["plan"],
      "properties": {
        "plan": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/UnifiedDiff"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApproveProposalInput": {
      "type": "object",
      "required": ["proposalEventId"],
      "properties": {
        "proposalEventId": {
          "$ref": "common.schema.json#/$defs/Ulid",
          "description": "Request.proposal.eventId, so a newer proposal is never approved by mistake."
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "RejectProposalInput": {
      "type": "object",
      "required": ["proposalEventId", "note"],
      "properties": {
        "proposalEventId": {
          "$ref": "common.schema.json#/$defs/Ulid",
          "description": "Request.proposal.eventId."
        },
        "note": {
          "$ref": "common.schema.json#/$defs/Markdown",
          "description": "The changes that the user asks for."
        }
      }
    },
    "LinkCommitsInput": {
      "type": "object",
      "required": ["commitSha", "requestIds"],
      "properties": {
        "commitSha": {
          "$ref": "common.schema.json#/$defs/CommitSha"
        },
        "requestIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Ulid"
          }
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "LinkPullRequestInput": {
      "type": "object",
      "required": ["url", "requestIds"],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/PullRequestUrl"
        },
        "requestIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/Ulid"
          }
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "CreateDraftInput": {
      "type": "object",
      "required": ["kind", "body"],
      "properties": {
        "kind": {
          "enum": ["new_request", "reply"]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "anchor.schema.json#/$defs/AnchorInput"
            },
            {
              "type": "null"
            }
          ],
          "description": "new_request: absent or null makes a general request. reply: absent or null."
        },
        "requestId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "requireApproval": {
          "type": ["boolean", "null"],
          "default": false,
          "description": "new_request only. Absent or null: false."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "new_request"
              }
            }
          },
          "then": {
            "properties": {
              "requestId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reply"
              }
            }
          },
          "then": {
            "required": ["requestId"],
            "properties": {
              "requestId": {
                "type": "string"
              },
              "anchor": {
                "type": "null"
              },
              "requireApproval": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "UpdateDraftInput": {
      "type": "object",
      "required": ["body"],
      "properties": {
        "body": {
          "$ref": "common.schema.json#/$defs/Markdown"
        },
        "requireApproval": {
          "type": ["boolean", "null"],
          "description": "new_request drafts only; a reply draft answers 422. Absent or null keeps the value."
        }
      }
    },
    "SubmitDraftsInput": {
      "type": "object",
      "properties": {
        "summary": {
          "type": ["string", "null"],
          "maxLength": 65536
        }
      }
    },
    "ViewedFileInput": {
      "type": "object",
      "required": ["path", "viewed"],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/RepoPath"
        },
        "viewed": {
          "type": "boolean"
        }
      }
    },
    "CreateTokenInput": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "api-token.schema.json#/$defs/TokenName"
        },
        "repositoryId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null: all repositories of the tenant."
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null: no expiry. Else from now + 1 minute to now + 366 days."
        }
      }
    }
  }
}
