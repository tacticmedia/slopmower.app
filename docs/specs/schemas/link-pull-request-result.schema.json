{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/link-pull-request-result.schema.json",
  "title": "LinkPullRequestResult",
  "type": "object",
  "required": ["url", "requests", "events"],
  "properties": {
    "url": {
      "$ref": "common.schema.json#/$defs/PullRequestUrl"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "request-summary.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    }
  }
}
