{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$",
      "description": "ULID, Crockford base32. Upper case in output, case-insensitive in input."
    },
    "CommitSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Full SHA-1 or SHA-256 commit ID, lower case."
    },
    "CommitShaPrefix": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$",
      "description": "Full or abbreviated commit ID."
    },
    "ObjectSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Full git object ID of a blob, tree, or commit."
    },
    "RepoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!-)(?![^\\x00]*//)(?!([^\\x00]*/)?\\.\\.?(/|$))[^\\x00]*[^/\\x00]$",
      "description": "Relative path, '/' separators, no leading '/' or '-', no empty, '.' or '..' segment, no NUL byte."
    },
    "PullRequestUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://\\S+$",
      "description": "An https URL without whitespace. For a GitHub repository: https://github.com/{owner}/{name}/pull/{number} of the review's repository."
    },
    "DateTime": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339, UTC, 'Z' suffix, second precision."
    },
    "Markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "GitHub-flavoured Markdown with at least one non-whitespace character."
    },
    "UnifiedDiff": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "description": "Unified diff in git format, as `git diff` writes it, with 1 to 9 lines that start with `diff --git `."
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Opaque pagination cursor."
    },
    "EventSeq": {
      "type": "integer",
      "minimum": 0,
      "description": "Per-tenant event number, gapless, in commit order."
    },
    "RepositorySource": {
      "enum": ["github", "local"]
    },
    "RepositoryAccess": {
      "enum": ["active", "removed"]
    },
    "ReviewState": {
      "enum": ["open", "closed"]
    },
    "IndexState": {
      "enum": ["pending", "running", "ready", "failed"]
    },
    "RequestStatus": {
      "enum": ["open", "in_progress", "ready_for_review", "verified", "reopened", "wont_do"]
    },
    "Awaiting": {
      "enum": ["agent", "user", "none"]
    },
    "Resolution": {
      "enum": ["fixed", "wont_do"]
    },
    "AnchorKind": {
      "enum": ["line", "range", "symbol", "file"]
    },
    "ActorKind": {
      "enum": ["user", "agent", "system"]
    },
    "CommitLinkState": {
      "enum": ["pending", "available"]
    },
    "LocationStatus": {
      "enum": ["exact", "shifted", "changed", "orphaned"]
    },
    "OrphanReason": {
      "enum": ["file_deleted", "region_deleted", "ambiguous", "content_not_found"]
    },
    "ProposalState": {
      "enum": ["pending", "approved", "rejected"]
    },
    "Proposal": {
      "type": "object",
      "required": ["eventId", "state"],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/Ulid",
          "description": "The request.proposed event."
        },
        "state": {
          "$ref": "#/$defs/ProposalState"
        }
      }
    },
    "PullRequestState": {
      "enum": ["open", "draft", "merged", "closed", "unknown"],
      "description": "unknown: a local repository, a state not read yet, a pull request that GitHub does not find, or an installation without the permission Pull requests: read."
    },
    "SymbolKind": {
      "anyOf": [
        {
          "enum": ["class", "interface", "trait", "enum", "function", "method", "property", "class_constant", "enum_case", "constant", "struct", "type", "module", "macro", "block"]
        },
        {
          "type": "string"
        }
      ],
      "description": "Open set."
    },
    "Action": {
      "anyOf": [
        {
          "enum": ["reply", "claim", "release", "link_commits", "unlink_commit", "link_pull_request", "unlink_pull_request", "mark_ready_for_review", "mark_wont_do", "verify", "reopen", "propose_solution", "approve_proposal", "reject_proposal", "set_plan_requirement"]
        },
        {
          "type": "string"
        }
      ],
      "description": "Open set."
    },
    "EventType": {
      "anyOf": [
        {
          "enum": ["review.started", "review.closed", "request.opened", "request.commented", "request.claimed", "request.released", "commit.linked", "commit.unlinked", "commit.found", "pull_request.linked", "pull_request.unlinked", "request.ready_for_review", "request.wont_do", "request.verified", "request.reopened", "request.proposed", "request.proposal_approved", "request.proposal_rejected", "request.plan_required", "request.plan_waived", "batch.submitted"]
        },
        {
          "type": "string"
        }
      ],
      "description": "Open set."
    },
    "ThreadEntryType": {
      "anyOf": [
        {
          "enum": ["request.opened", "request.commented", "request.claimed", "request.released", "commit.linked", "commit.unlinked", "commit.found", "pull_request.linked", "pull_request.unlinked", "request.ready_for_review", "request.wont_do", "request.verified", "request.reopened", "request.proposed", "request.proposal_approved", "request.proposal_rejected", "request.plan_required", "request.plan_waived"]
        },
        {
          "type": "string"
        }
      ],
      "description": "Open set."
    },
    "ErrorCode": {
      "anyOf": [
        {
          "enum": ["unauthorized", "forbidden", "not_found", "invalid_input", "invalid_transition", "review_closed", "commits_not_available", "commit_not_found", "repository_unavailable", "internal_error"]
        },
        {
          "type": "string"
        }
      ],
      "description": "Open set."
    }
  }
}
