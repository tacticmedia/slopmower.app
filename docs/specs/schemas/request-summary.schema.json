{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holistic-review.invalid/schemas/v1/request-summary.schema.json",
  "title": "RequestSummary",
  "type": "object",
  "required": ["id", "reviewId", "repositoryId", "status", "awaiting", "resolution", "closed", "anchor", "summary", "author", "claimedBy", "claimedAt", "commentCount", "commitCount", "pendingCommitCount", "outdated", "createdAt", "updatedAt", "lastEventSeq", "carriedFrom", "requireApproval", "proposal"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "reviewId": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "repositoryId": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/RequestStatus"
    },
    "awaiting": {
      "$ref": "common.schema.json#/$defs/Awaiting"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Resolution"
        },
        {
          "type": "null"
        }
      ]
    },
    "closed": {
      "type": "boolean",
      "description": "verified, or wont_do set by the user."
    },
    "anchor": {
      "anyOf": [
        {
          "$ref": "anchor.schema.json#/$defs/AnchorSummary"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null for a general request, which belongs to the whole review."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "First non-blank line of body, trimmed. A longer line is cut and ends with U+2026 HORIZONTAL ELLIPSIS."
    },
    "author": {
      "$ref": "actor.schema.json"
    },
    "claimedBy": {
      "anyOf": [
        {
          "$ref": "actor.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "claimedAt": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "commentCount": {
      "type": "integer",
      "minimum": 0
    },
    "commitCount": {
      "type": "integer",
      "minimum": 0
    },
    "pendingCommitCount": {
      "type": "integer",
      "minimum": 0
    },
    "outdated": {
      "type": ["boolean", "null"],
      "description": "Location at the default-branch head is changed or orphaned. Null until computed, when the clone is gone, and for a general request."
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "lastEventSeq": {
      "$ref": "common.schema.json#/$defs/EventSeq",
      "description": "seq of the last entry of the request's thread."
    },
    "carriedFrom": {
      "anyOf": [
        {
          "$ref": "#/$defs/CarriedFrom"
        },
        {
          "type": "null"
        }
      ],
      "description": "The source request that V15 carried over to this request. Null for any other request."
    },
    "requireApproval": {
      "type": "boolean",
      "description": "\"Ask for a plan first\": link_commits and mark_ready_for_review need an approved proposal. Set when the request opens, changed by Q18."
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Proposal"
        },
        {
          "type": "null"
        }
      ],
      "description": "The current proposal of the claim. Null without one; release, won't do, and reopen set it to null."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "in_progress"
          }
        }
      },
      "then": {
        "properties": {
          "claimedBy": {
            "$ref": "actor.schema.json"
          },
          "claimedAt": {
            "$ref": "common.schema.json#/$defs/DateTime"
          }
        }
      },
      "else": {
        "properties": {
          "claimedBy": {
            "type": "null"
          },
          "claimedAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": ["anchor"],
        "properties": {
          "anchor": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "outdated": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "CarriedFrom": {
      "type": "object",
      "required": ["reviewId", "requestId"],
      "properties": {
        "reviewId": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/Ulid"
        }
      }
    }
  }
}
