{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/me.schema.json",
  "title": "Me",
  "type": "object",
  "required": ["user", "tenantId", "caller", "token", "features", "plan", "usage", "links", "preferences"],
  "properties": {
    "user": {
      "type": "object",
      "required": ["id", "login", "name", "avatarUrl", "signInMethod"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": ["string", "null"]
        },
        "avatarUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "signInMethod": {
          "enum": ["github", "local"]
        }
      }
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "caller": {
      "$ref": "actor.schema.json"
    },
    "token": {
      "anyOf": [
        {
          "$ref": "api-token.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "type": "object",
      "required": ["localRepositories", "githubApp"],
      "properties": {
        "localRepositories": {
          "type": "boolean"
        },
        "githubApp": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["slug", "installUrl"],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "installUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          ]
        }
      }
    },
    "plan": {
      "$ref": "#/$defs/TenantPlan"
    },
    "usage": {
      "type": "array",
      "description": "The use and the limit of each usage limit of the tenant, in the order of UsageLimit.",
      "items": {
        "$ref": "#/$defs/LimitUsage"
      }
    },
    "links": {
      "type": "object",
      "required": ["mcpUrl", "docsUrl", "skillUrl"],
      "properties": {
        "mcpUrl": {
          "type": "string",
          "format": "uri"
        },
        "docsUrl": {
          "type": "string",
          "format": "uri"
        },
        "skillUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    }
  },
  "$defs": {
    "Preferences": {
      "type": "object",
      "description": "The preferences of the user. They belong to the account, not to a browser. A bearer call gets those of the token owner.",
      "required": ["completedTours"],
      "properties": {
        "completedTours": {
          "type": "array",
          "uniqueItems": true,
          "description": "The parts of the review tour that the user finished or dismissed, in the order of Tour. The web UI shows the other parts.",
          "items": {
            "$ref": "common.schema.json#/$defs/Tour"
          }
        }
      }
    },
    "TenantPlan": {
      "type": "object",
      "description": "The plan whose limits the tenant has: the plan with the highest rank among the GitHub accounts of the user and of the installations of the tenant. An account without a Marketplace plan has the free plan.",
      "required": ["name", "trialEndsAt", "pendingChange", "listingUrl"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trialEndsAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "The end of the free trial of the plan, null without a trial."
        },
        "pendingChange": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "A downgrade or a cancellation that GitHub applies at the end of the billing cycle. A cancellation changes to the free plan.",
              "required": ["name", "effectiveAt"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "effectiveAt": {
                  "$ref": "common.schema.json#/$defs/DateTime"
                }
              }
            }
          ]
        },
        "listingUrl": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "The GitHub Marketplace listing, where the user changes the plan. Null when the instance has no listing."
        }
      }
    },
    "LimitUsage": {
      "type": "object",
      "required": ["limit", "max", "current"],
      "properties": {
        "limit": {
          "$ref": "common.schema.json#/$defs/UsageLimit"
        },
        "max": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The limit of the plan of the tenant, null when the limit is off. Bytes for repository_size and tenant_storage."
        },
        "current": {
          "type": "integer",
          "minimum": 0,
          "description": "The use, in the unit of max. For requests_per_review the largest open review, for repository_size the largest clone."
        }
      }
    }
  }
}
