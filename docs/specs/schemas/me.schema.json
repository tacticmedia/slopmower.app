{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/me.schema.json",
  "title": "Me",
  "type": "object",
  "required": ["user", "tenantId", "caller", "token", "features", "usage", "links"],
  "properties": {
    "user": {
      "type": "object",
      "required": ["id", "login", "name", "avatarUrl", "signInMethod"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": ["string", "null"]
        },
        "avatarUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "signInMethod": {
          "enum": ["github", "local"]
        }
      }
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/Ulid"
    },
    "caller": {
      "$ref": "actor.schema.json"
    },
    "token": {
      "anyOf": [
        {
          "$ref": "api-token.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "features": {
      "type": "object",
      "required": ["localRepositories", "githubApp"],
      "properties": {
        "localRepositories": {
          "type": "boolean"
        },
        "githubApp": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["slug", "installUrl"],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "installUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          ]
        }
      }
    },
    "usage": {
      "type": "array",
      "description": "The use and the limit of each usage limit of the tenant, in the order of UsageLimit.",
      "items": {
        "$ref": "#/$defs/LimitUsage"
      }
    },
    "links": {
      "type": "object",
      "required": ["mcpUrl", "docsUrl", "skillUrl"],
      "properties": {
        "mcpUrl": {
          "type": "string",
          "format": "uri"
        },
        "docsUrl": {
          "type": "string",
          "format": "uri"
        },
        "skillUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "$defs": {
    "LimitUsage": {
      "type": "object",
      "required": ["limit", "max", "current"],
      "properties": {
        "limit": {
          "$ref": "common.schema.json#/$defs/UsageLimit"
        },
        "max": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "The limit of the plan of the tenant, null when the limit is off. Bytes for repository_size and tenant_storage."
        },
        "current": {
          "type": "integer",
          "minimum": 0,
          "description": "The use, in the unit of max. For requests_per_review the largest open review, for repository_size the largest clone."
        }
      }
    }
  }
}
