{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slopmower.invalid/schemas/v1/project.schema.json",
  "title": "Project",
  "description": "A project of the issue tracker. A repository belongs to at most one project (D116).",
  "type": "object",
  "required": ["key", "name", "approvalMode", "repositories"],
  "properties": {
    "key": {
      "$ref": "common.schema.json#/$defs/ProjectKey"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "approvalMode": {
      "$ref": "common.schema.json#/$defs/ApprovalMode"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "description": "The names of the repositories of the project that the caller sees, as in Repository.name, in name order."
    }
  }
}
