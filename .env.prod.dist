# Production template: every variable whose .env default is wrong in production. Symfony never loads this file.
# Set the values in the environment of every PHP process (web server, each Messenger worker, each console command), or
# copy them into .env.prod.local and run `composer dump-env prod`. Commented lines apply only in the situation they
# name. docs/deployment.md describes the database connection and the symbols service.

APP_ENV=prod
# Secret: 32 random bytes, for example `php -r 'echo bin2hex(random_bytes(32));'`.
APP_SECRET=

# The public URL, without a trailing slash: the base of the Mercure topics and of the URLs that console commands build.
DEFAULT_URI=https://review.example.com
# The host of DEFAULT_URI, without the port. The MCP endpoint /_mcp accepts requests for this host only.
APP_PUBLIC_HOST=review.example.com

# Tenant clones: persistent storage outside the release directory, shared by the web server and the workers.
APP_TENANT_DATA_DIR=/srv/holistic-review/tenants
# When each deployment gets a new release directory, or the web server and the workers run in separate containers: a
# local directory that every PHP process of the host shares. It holds cache.app, the RDS credential pool, and the
# messenger:stop-workers signal.
#APP_SHARE_DIR=/srv/holistic-review/share

# Database (D63).
DATABASE_HOST=app.abcdefghijkl.ap-southeast-2.rds.amazonaws.com
DATABASE_NAME=app
DATABASE_USER=app
# Secret: the raw password, not URL-encoded. In a .env file, keep the single quotes. IAM mode replaces it.
DATABASE_PASSWORD=''
# The major version of the database engine.
DATABASE_SERVER_VERSION=18
# verify-full needs PGSSLROOTCERT, the path of the RDS certificate bundle, in the environment of the PHP process.
DATABASE_SSLMODE=verify-full
# When the port is not 5432.
#DATABASE_PORT=5432

# RDS credentials (D58). With AWS_REGION, RDS_IAM_USERNAME selects IAM token authentication, and RDS_SECRET_ARN reads
# the master password from Secrets Manager after a rotation. Without both, DATABASE_USER and DATABASE_PASSWORD apply.
#AWS_REGION=ap-southeast-2
#RDS_IAM_USERNAME=app_iam
#RDS_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:rds!db-00000000-0000-0000-0000-000000000000

# The symbols service (D56). The .env default http://symbols:3000 resolves only in the Compose network.
SYMBOLS_URL=http://127.0.0.1:3000

# Mercure hub: the URL that the PHP processes publish to, and the URL that browsers subscribe to.
MERCURE_URL=https://review.example.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://review.example.com/.well-known/mercure
# Secret: the HS256 key of the hub, at least 32 bytes. The hub must use the same key for publishers and subscribers.
MERCURE_JWT_SECRET=

# Behind a load balancer or a reverse proxy: its addresses, or PRIVATE_SUBNETS, so that Symfony trusts X-Forwarded-*.
#SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS

# GitHub App, when the instance connects GitHub. An empty client ID means no GitHub App.
#GITHUB_APP_CLIENT_ID=
#GITHUB_APP_SLUG=
# Secrets, here or in the secrets vault. A non-empty value here wins over the vault.
#GITHUB_APP_CLIENT_SECRET=
#GITHUB_APP_PRIVATE_KEY=
#GITHUB_APP_WEBHOOK_SECRET=

# When the instance offers local repositories: the directory whose git repositories every tenant may connect.
#APP_LOCAL_REPOSITORIES_DIR=
