# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> symfony/panther ###
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
###< symfony/panther ###

PANTHER_EXTERNAL_BASE_URI=http://localhost:8081
APP_LOCAL_REPOSITORIES_DIR=var/test/local-repositories
APP_TENANT_DATA_DIR=var/test/tenants
MERCURE_URL=http://localhost:8081/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:8081/.well-known/mercure

