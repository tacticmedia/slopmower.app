# Environment of the act job, in place of the Symfony .env. Its own compose project and ports keep the developer
# stack untouched. ACT_HTTP_PORT, ACT_DATABASE_PORT, and ACT_UI_PORT in .env.make.local override the ports.
COMPOSE_PROJECT_NAME=holistic-review-act
HTTP_PORT=8290
DATABASE_PORT=5490
UI_PORT=4290
