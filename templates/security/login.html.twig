{% extends 'base.html.twig' %}

{% block title %}Sign in - Slopmower{% endblock %}

{% block body %}
    <main>
        <h1>Sign in to Slopmower</h1>

        {% if error %}
            <p role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        {% if github_sign_in %}
            <p><a href="{{ path('hwi_oauth_service_redirect', {service: 'github'}) }}" role="button">Sign in with GitHub</a></p>
        {% endif %}

        {% if local_login %}
            <form method="post" action="{{ path('app_login_local') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_token_id) }}">
                <button type="submit">Sign in as {{ local_login }}</button>
            </form>
        {% endif %}

        {% if not github_sign_in and not local_login %}
            <p>No sign-in method is configured.</p>
        {% endif %}
    </main>
{% endblock %}
