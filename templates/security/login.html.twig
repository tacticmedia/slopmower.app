{% extends 'base.html.twig' %}

{% block title %}Sign in - Slopmower{% endblock %}

{% block stylesheets %}
    {{ include('_theme.html.twig') }}
    {# The brand pane is dark, in warm grays, in both colour modes. #}
    <style>
        body { display: flex; flex-direction: column; min-height: 100vh; }
        .login-page { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }

        .login-brand { display: flex; flex-direction: column; justify-content: center; gap: 1.5rem; padding: 3rem clamp(2rem, 6vw, 6rem); color: #fafaf9; background: radial-gradient(60rem 40rem at 0% 0%, #23863633, transparent 60%), #1c1917; }
        .login-brand p { margin: 0; }
        .login-wordmark { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.25px; }
        .login-tagline { max-width: 30rem; font-size: clamp(1.75rem, 3.2vw, 2.75rem); font-weight: 600; line-height: 1.15; letter-spacing: -1px; }
        .login-pitch { max-width: 30rem; color: #a8a29e; font-size: 1.125rem; }

        .login-preview { max-width: 30rem; margin-top: 1rem; overflow: hidden; border: 1px solid #44403c; border-radius: 6px; background: #0c0a09; box-shadow: 0 8px 24px #0c0a0999; font-size: 0.8125rem; }
        .login-preview-file { padding: 0.5rem 1rem; border-bottom: 1px solid #44403c; color: #a8a29e; font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace; font-size: 0.75rem; }
        .login-preview pre { margin: 0; padding: 0.5rem 0; overflow: hidden; font: 0.75rem/1.6 ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace; }
        .login-preview pre span[data-line] { display: block; padding: 0 1rem 0 0; white-space: pre; }
        .login-preview pre span[data-line]::before { content: attr(data-line); display: inline-block; width: 3rem; padding-right: 1rem; color: #78716c; text-align: right; }
        .login-preview pre .marked { box-shadow: inset 2px 0 0 #9e6a03; background: #bb800926; }
        .login-preview .k { color: #ff7b72; }
        .login-preview .f { color: #d2a8ff; }
        .login-preview .s { color: #a5d6ff; }
        .login-preview .c { color: #79c0ff; }
        .login-thread { display: grid; gap: 0.75rem; padding: 0.75rem 1rem; border-top: 1px solid #44403c; background: #1c1917; }
        .login-comment { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: 0.5rem; line-height: 1.4; }
        .login-avatar { width: 1.25rem; height: 1.25rem; border-radius: 50%; background: #57534e; }
        .login-avatar.agent { background: #238636; }
        .login-comment strong { margin-right: 0.375rem; }
        .login-state { display: inline-block; margin-top: 0.375rem; padding: 0 0.5rem; border: 1px solid #238636; border-radius: 2rem; color: #3fb950; background: #2ea04326; font-size: 0.75rem; font-weight: 500; }

        .login-panel { display: flex; flex-direction: column; }
        .login { flex: 1; display: flex; flex-direction: column; justify-content: center; width: 100%; max-width: 22rem; margin: 0 auto; padding: 3rem 1rem; }
        .login h1 { margin: 0 0 1.5rem; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.5px; }
        .login-box { display: grid; gap: 0.75rem; font-size: 0.875rem; }
        .login-box p, .login-box form { margin: 0; }
        .login-box .login-alert { padding: 0.75rem 1rem; border: 1px solid var(--borderColor-danger-muted); border-radius: 6px; background: var(--bgColor-danger-muted); }
        .login-button { display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; height: 2.75rem; padding: 0 1rem; border: 1px solid var(--borderColor-default); border-radius: 6px; color: var(--button-default-fgColor-rest); background: var(--button-default-bgColor-rest); box-shadow: var(--shadow-resting-small); font: inherit; font-size: 0.875rem; font-weight: 500; text-decoration: none; cursor: pointer; }
        .login-button:hover { background: var(--button-default-bgColor-hover); }
        .login-button:active { background: var(--button-default-bgColor-active); }
        .login-button.primary { border-color: var(--button-primary-borderColor-rest); color: var(--button-primary-fgColor-rest); background: var(--button-primary-bgColor-rest); }
        .login-button.primary:hover { background: var(--button-primary-bgColor-hover); }
        .login-button.primary:active { background: var(--button-primary-bgColor-active); }
        .login-button svg { fill: currentColor; }
        .login-new { margin: 1.5rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--borderColor-muted); color: var(--fgColor-muted); font-size: 0.875rem; }
        .login-footer { padding: 1.5rem 1rem; font-size: 0.75rem; }
        .login-footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem; }
        .login-footer a { color: var(--fgColor-muted); }

        @media (max-width: 767px) {
            .login-page { display: flex; flex-direction: column; }
            .login-panel { flex: 1; }
            .login-brand { gap: 0.75rem; padding: 2rem 1rem; }
            .login-pitch { font-size: 1rem; }
            .login-preview { display: none; }
            .login { justify-content: flex-start; padding: 2rem 1rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-page">
        <section class="login-brand" aria-label="About Slopmower">
            <p class="login-wordmark">Slopmower</p>
            <p class="login-tagline">The slop needs mowing as fast as it keeps growing.</p>
            <p class="login-pitch">Review the whole codebase at one commit. Comment on any line, and your coding agent answers, asks, or does the work.</p>
            <div class="login-preview" aria-hidden="true">
                <div class="login-preview-file">src/users.ts</div>
                <pre><span data-line="12"><span class="k">export async function</span> <span class="f">fetchUser</span>(id) {</span><span data-line="13" class="marked">  <span class="k">while</span> (<span class="c">true</span>) {</span><span data-line="14">    <span class="k">try</span> { <span class="k">return await</span> api.<span class="f">get</span>(<span class="s">`/users/${id}`</span>); }</span><span data-line="15">    <span class="k">catch</span> { <span class="k">await</span> <span class="f">sleep</span>(<span class="c">1000</span>); }</span><span data-line="16">  }</span><span data-line="17">}</span></pre>
                <div class="login-thread">
                    <div class="login-comment">
                        <span class="login-avatar"></span>
                        <div><strong>you</strong>This retries forever. Stop after 3 attempts.</div>
                    </div>
                    <div class="login-comment">
                        <span class="login-avatar agent"></span>
                        <div><strong>agent</strong>Done in 4f2c9e1, with a backoff.<br><span class="login-state">Ready for review</span></div>
                    </div>
                </div>
            </div>
        </section>

        <div class="login-panel">
            <main class="login">
                <h1>Sign in to Slopmower</h1>

                <div class="login-box">
                    {% if error %}
                        <p class="login-alert" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    {% endif %}

                    {% if github_sign_in %}
                        <a class="login-button primary" href="{{ path('hwi_oauth_service_redirect', {service: 'github'}) }}" role="button">
                            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></svg>
                            Sign in with GitHub
                        </a>
                    {% endif %}

                    {% if local_login %}
                        <form method="post" action="{{ path('app_login_local') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_token_id) }}">
                            <button class="login-button" type="submit">Sign in as {{ local_login }}</button>
                        </form>
                    {% endif %}

                    {% if not github_sign_in and not local_login %}
                        <p>No sign-in method is configured.</p>
                    {% endif %}
                </div>

                <p class="login-new">New to Slopmower? See <a href="{{ path('docs_index') }}">how it works</a></p>
            </main>
            <footer class="login-footer">
                {{ include('_legal_links.html.twig') }}
            </footer>
        </div>
    </div>
{% endblock %}
