<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Slopmower{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
        <script>
            document.addEventListener('submit', (event) => {
                const field = event.target.querySelector('input[name="_csrf_token"]');
                if (null === field) {
                    return;
                }
                // The stateless placeholder is the cookie name. A session token is longer and stays as it is.
                if (undefined === field.dataset.csrfCookie) {
                    if (!/^[-_a-zA-Z0-9]{4,22}$/.test(field.value)) {
                        return;
                    }
                    field.dataset.csrfCookie = field.value;
                }
                const cookie = field.dataset.csrfCookie;
                const token = btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(18)))).replaceAll('+', '-').replaceAll('/', '_');
                const secure = 'https:' === location.protocol;
                document.cookie = `${secure ? '__Host-' : ''}${cookie}_${token}=${cookie}; path=/; samesite=strict${secure ? '; secure' : ''}`;
                field.value = token;
            }, true);
        </script>
        <style>
            .cookie-notice { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 0.5rem 1rem; font: 14px/1.5 system-ui, sans-serif; color: #1f2328; background: #f6f8fa; border-bottom: 1px solid #d1d9e0; }
            .cookie-notice[hidden] { display: none; }
            .cookie-notice p { margin: 0; }
            .cookie-notice a { color: #0969da; }
        </style>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body
        {%- if app_release %} data-release="{{ app_release }}"{% endif %}
        {%- if sentry_dsn %} data-sentry-dsn="{{ sentry_dsn }}" data-sentry-environment="{{ sentry_environment }}"{% endif %}>
        {# In the flow above the page, so it covers no control. Every cookie is necessary, so it asks for no consent. #}
        <section class="cookie-notice" aria-label="Cookie notice" hidden>
            <p>Slopmower uses only the cookies and browser storage that the service needs. <a href="{{ path('docs_page', {slug: 'privacy'}) }}">Privacy policy</a></p>
            <button type="button">Got it</button>
        </section>
        <script>
            (() => {
                const notice = document.currentScript.previousElementSibling;
                const key = 'slopmower.cookieNoticeDismissed';
                try {
                    if (null !== localStorage.getItem(key)) {
                        return;
                    }
                } catch {}
                notice.hidden = false;
                notice.querySelector('button').addEventListener('click', () => {
                    notice.hidden = true;
                    try {
                        localStorage.setItem(key, '1');
                    } catch {}
                });
            })();
        </script>
        {% block body %}{% endblock %}
    </body>
</html>
