{% extends 'base.html.twig' %}

{% block title %}{% if title %}{{ title }} - {% endif %}Slopmower Help{% endblock %}

{% block stylesheets %}
    {# The colours are Primer tokens of @primer/primitives, light and dark. #}
    <style>
        :root {
            color-scheme: light;
            --fgColor-default: #1f2328;
            --fgColor-muted: #59636e;
            --fgColor-accent: #0969da;
            --bgColor-default: #ffffff;
            --bgColor-muted: #f6f8fa;
            --bgColor-neutral-muted: #818b981f;
            --borderColor-default: #d1d9e0;
            --borderColor-muted: #d1d9e0b3;
            --borderColor-accent-emphasis: #0969da;
            --header-bgColor: #25292e;
            --header-fgColor-default: #ffffffb3;
            --header-fgColor-logo: #ffffff;
            --header-borderColor-divider: #818b98;
            --docs-header-height: 3.5rem;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                color-scheme: dark;
                --fgColor-default: #f0f6fc;
                --fgColor-muted: #9198a1;
                --fgColor-accent: #4493f8;
                --bgColor-default: #0d1117;
                --bgColor-muted: #151b23;
                --bgColor-neutral-muted: #656c7633;
                --borderColor-default: #3d444d;
                --borderColor-muted: #3d444db3;
                --borderColor-accent-emphasis: #1f6feb;
                --header-bgColor: #151b23;
                --header-fgColor-logo: #f0f6fc;
                --header-borderColor-divider: #656c76;
            }
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-padding-top: calc(var(--docs-header-height) + 1rem); }
        body { margin: 0; font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif; color: var(--fgColor-default); background: var(--bgColor-default); }
        a { color: var(--fgColor-accent); text-underline-offset: 0.2em; }
        :focus-visible { outline: 2px solid var(--borderColor-accent-emphasis); outline-offset: 2px; }
        .cookie-notice { color: var(--fgColor-default); background: var(--bgColor-muted); border-bottom-color: var(--borderColor-default); }
        .cookie-notice a { color: var(--fgColor-accent); }

        .docs-skip { position: absolute; left: 1rem; top: -3rem; z-index: 2; padding: 0.5rem 1rem; border-radius: 6px; color: var(--fgColor-default); background: var(--bgColor-default); }
        .docs-skip:focus { top: 0.5rem; }
        .docs-header { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: var(--docs-header-height); padding: 0 1.5rem; background: var(--header-bgColor); box-shadow: inset 0 -1px 0 var(--borderColor-muted); }
        .docs-brand { color: var(--header-fgColor-logo); font-weight: 600; text-decoration: none; white-space: nowrap; }
        .docs-app-link { padding: 0.25rem 0.75rem; border: 1px solid var(--header-borderColor-divider); border-radius: 6px; color: var(--header-fgColor-logo); font-size: 0.875rem; font-weight: 500; text-decoration: none; white-space: nowrap; }
        .docs-app-link:hover { border-color: var(--header-fgColor-default); }

        .docs-layout { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 3rem; max-width: 76rem; margin: 0 auto; padding: 0 1.5rem; }
        .docs-nav { position: sticky; top: var(--docs-header-height); align-self: start; max-height: calc(100vh - var(--docs-header-height)); overflow-y: auto; padding: 1.5rem 0 1.5rem 0.5rem; font-size: 0.875rem; }
        .docs-nav summary { cursor: pointer; padding: 0.5rem 0.75rem; border: 1px solid var(--borderColor-default); border-radius: 6px; font-weight: 600; }
        .docs-nav-title { margin: 1rem 0 0.25rem; padding: 0 0.5rem; color: var(--fgColor-muted); font-size: 0.75rem; font-weight: 600; }
        .docs-nav summary + .docs-nav-title { margin-top: 0.75rem; }
        .docs-nav ul { margin: 0; padding: 0; list-style: none; }
        .docs-nav li a { position: relative; display: block; padding: 0.25rem 0.5rem; border-radius: 6px; color: var(--fgColor-default); text-decoration: none; }
        .docs-nav li a:hover { background: var(--bgColor-neutral-muted); }
        .docs-nav a[aria-current="page"] { background: var(--bgColor-neutral-muted); font-weight: 600; }
        .docs-nav a[aria-current="page"]::before { content: ""; position: absolute; top: 50%; left: -0.5rem; width: 4px; height: 1.5rem; border-radius: 6px; background: var(--borderColor-accent-emphasis); transform: translateY(-50%); }
        @media (min-width: 768px) {
            @supports selector(::details-content) {
                .docs-nav summary { display: none; }
                .docs-nav-menu::details-content { content-visibility: visible; }
                .docs-nav summary + .docs-nav-title { margin-top: 0; }
            }
        }

        .docs-content { min-width: 0; max-width: 48rem; padding: 2rem 0 3rem; overflow-wrap: break-word; }
        .docs-content h1, .docs-content h2, .docs-content h3 { line-height: 1.25; font-weight: 600; }
        .docs-content h1 { margin: 0 0 1rem; padding-bottom: 0.3em; border-bottom: 1px solid var(--borderColor-muted); font-size: 2rem; }
        .docs-content h2 { margin: 2rem 0 1rem; padding-bottom: 0.3em; border-bottom: 1px solid var(--borderColor-muted); font-size: 1.5rem; }
        .docs-content h3 { margin: 1.5rem 0 1rem; font-size: 1.25rem; }
        .docs-content p, .docs-content ul, .docs-content ol, .docs-content table, .docs-content pre { margin: 0 0 1rem; }
        .docs-content ul, .docs-content ol { padding-left: 2em; }
        .docs-content li + li { margin-top: 0.25rem; }
        .docs-content li > ul, .docs-content li > ol { margin: 0.25rem 0 0; }
        code, pre { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace; font-size: 0.875em; border-radius: 6px; }
        code { padding: 0.2em 0.4em; background: var(--bgColor-neutral-muted); }
        pre { padding: 1rem; overflow-x: auto; line-height: 1.45; background: var(--bgColor-muted); }
        pre code { padding: 0; background: none; font-size: 1em; }
        .docs-content table { display: block; width: max-content; max-width: 100%; overflow: auto; border-collapse: collapse; }
        .docs-content th, .docs-content td { padding: 0.375rem 0.75rem; border: 1px solid var(--borderColor-default); text-align: left; vertical-align: top; }
        .docs-content th { font-weight: 600; }
        .docs-content tr:nth-child(2n) td { background: var(--bgColor-muted); }
        .docs-content .table-of-contents { padding: 0.75rem 1rem 0.75rem 2.25rem; border: 1px solid var(--borderColor-default); border-radius: 6px; font-size: 0.875rem; }
        .docs-content .table-of-contents::before { content: "On this page"; display: block; margin: 0 0 0.5rem -1.25rem; color: var(--fgColor-muted); font-weight: 600; }
        .docs-content .table-of-contents li + li { margin-top: 0.125rem; }
        @media (min-width: 768px) {
            .docs-content .table-of-contents { columns: 2; column-gap: 2.5rem; }
            .docs-content .table-of-contents::before { column-span: all; }
            .docs-content .table-of-contents li { break-inside: avoid; }
        }

        .docs-footer { padding: 1.5rem; border-top: 1px solid var(--borderColor-muted); color: var(--fgColor-muted); font-size: 0.875rem; }
        .docs-footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.5rem; max-width: 76rem; margin: 0 auto; }

        @media (max-width: 767px) {
            .docs-header { padding: 0 1rem; }
            .docs-layout { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0 1rem; }
            .docs-nav { position: static; max-height: none; overflow: visible; padding: 1rem 0 0; }
            .docs-nav-menu[open] { padding-bottom: 0.5rem; border-bottom: 1px solid var(--borderColor-muted); }
            .docs-content { padding-top: 1.5rem; }
            .docs-content h1 { font-size: 1.75rem; }
            .docs-content h2 { font-size: 1.375rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <a class="docs-skip" href="#content">Skip to content</a>
    <header class="docs-header">
        <a class="docs-brand" href="{{ path('docs_index') }}">Slopmower Help</a>
        <a class="docs-app-link" href="{{ path('shell_home') }}">Open Slopmower</a>
    </header>
    <div class="docs-layout">
        {{ include('docs/_navigation.html.twig') }}
        <main class="docs-content" id="content">
            {% block content %}{% endblock %}
        </main>
    </div>
    <footer class="docs-footer">
        {{ include('_legal_links.html.twig') }}
    </footer>
{% endblock %}
